# ══════════════════════════════════════════════════════════════════════════
# PASO 3 del runbook — activar SOLO después de que `lab-b` ya esté aplicado.
#
# Cómo activarlo:
#   mv lab-b-integration.tf.step3 lab-b-integration.tf
#   terraform plan   (en environments/qa)
#   terraform apply
#
# Por qué en dos pasos: estos data sources buscan por tag los Security
# Groups de reservation/payment/realtime que crea `lab-b`. Si corres esto
# antes de que lab-b exista, el data source no encuentra nada y falla el plan.
# ══════════════════════════════════════════════════════════════════════════

data "aws_security_group" "lab_b" {
  for_each = toset(["reservation", "payment", "realtime"])

  filter {
    name   = "tag:Name"
    values = ["lab-b-${each.value}-sg"]
  }
}

# parking, user y vehicle ahora reciben llamadas de reservation, que vive en Lab B
resource "aws_security_group_rule" "parking_from_labb_reservation" {
  type                     = "ingress"
  from_port                = 3004
  to_port                  = 3004
  protocol                 = "tcp"
  source_security_group_id = data.aws_security_group.lab_b["reservation"].id
  security_group_id        = module.security_groups.security_group_ids["parking"]
  description              = "parking accesible desde reservation (Lab B, vía peering)"
}

resource "aws_security_group_rule" "user_from_labb_reservation" {
  type                     = "ingress"
  from_port                = 3001
  to_port                  = 3001
  protocol                 = "tcp"
  source_security_group_id = data.aws_security_group.lab_b["reservation"].id
  security_group_id        = module.security_groups.security_group_ids["user"]
  description              = "user accesible desde reservation (Lab B, vía peering)"
}

resource "aws_security_group_rule" "vehicle_from_labb_reservation" {
  type                     = "ingress"
  from_port                = 3003
  to_port                  = 3003
  protocol                 = "tcp"
  source_security_group_id = data.aws_security_group.lab_b["reservation"].id
  security_group_id        = module.security_groups.security_group_ids["vehicle"]
  description              = "vehicle accesible desde reservation (Lab B, vía peering)"
}

# user también recibe llamadas de payment (lookup de perfil/rol)
resource "aws_security_group_rule" "user_from_labb_payment" {
  type                     = "ingress"
  from_port                = 3001
  to_port                  = 3001
  protocol                 = "tcp"
  source_security_group_id = data.aws_security_group.lab_b["payment"].id
  security_group_id        = module.security_groups.security_group_ids["user"]
  description              = "user accesible desde payment (Lab B, vía peering)"
}

# auth (que hostea postgres/redis/kafka/rabbitmq) ahora recibe conexiones
# de reservation, payment y realtime desde Lab B
resource "aws_security_group_rule" "auth_postgres_from_labb" {
  for_each                 = data.aws_security_group.lab_b
  type                     = "ingress"
  from_port                = 5432
  to_port                  = 5432
  protocol                 = "tcp"
  source_security_group_id = each.value.id
  security_group_id        = module.security_groups.security_group_ids["auth"]
  description              = "PostgreSQL desde ${each.key} (Lab B, vía peering)"
}

resource "aws_security_group_rule" "auth_redis_from_labb" {
  for_each                 = data.aws_security_group.lab_b
  type                     = "ingress"
  from_port                = 6379
  to_port                  = 6379
  protocol                 = "tcp"
  source_security_group_id = each.value.id
  security_group_id        = module.security_groups.security_group_ids["auth"]
  description              = "Redis desde ${each.key} (Lab B, vía peering)"
}

resource "aws_security_group_rule" "auth_kafka_from_labb" {
  for_each                 = data.aws_security_group.lab_b
  type                     = "ingress"
  from_port                = 9092
  to_port                  = 9092
  protocol                 = "tcp"
  source_security_group_id = each.value.id
  security_group_id        = module.security_groups.security_group_ids["auth"]
  description              = "Kafka desde ${each.key} (Lab B, vía peering)"
}

resource "aws_security_group_rule" "auth_rabbitmq_from_labb_payment" {
  type                     = "ingress"
  from_port                = 5672
  to_port                  = 5672
  protocol                 = "tcp"
  source_security_group_id = data.aws_security_group.lab_b["payment"].id
  security_group_id        = module.security_groups.security_group_ids["auth"]
  description              = "RabbitMQ desde payment (Lab B, vía peering)"
}
