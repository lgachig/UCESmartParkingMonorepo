FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma

RUN npm install --frozen-lockfile

COPY . .

ENV NX_DAEMON=false

RUN npx prisma generate --config prisma.vehicle.config.ts
RUN npx nx sync
RUN npx nx build @org/vehicle-service

EXPOSE 3003

CMD ["node", "apps/vehicle-service/dist/main.js"]
