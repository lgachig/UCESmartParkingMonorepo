FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma

RUN npm install --frozen-lockfile

COPY . .

ENV NX_DAEMON=false

RUN npx prisma generate --config prisma.payment.config.ts
RUN npx nx build @org/payment-service

EXPOSE 3007

CMD ["node", "apps/payment-service/dist/main.js"]