generator client {
  provider = "prisma-client"
  output   = "../../generated/reservation-client"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  PENDING
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

model Reservation {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  vehicleId        String            @map("vehicle_id")
  slotId           String            @map("slot_id")
  reservationCode  String            @unique @map("reservation_code")
  status           ReservationStatus @default(PENDING)
  reservedAt       DateTime          @default(now()) @map("reserved_at")
  expiresAt        DateTime          @map("expires_at")
  checkInAt        DateTime?         @map("check_in_at")
  checkOutAt       DateTime?         @map("check_out_at")
  durationMinutes  Int?              @map("duration_minutes")
  cancelledAt      DateTime?         @map("cancelled_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([userId])
  @@index([slotId])
  @@index([vehicleId])
  @@index([status])
  @@map("reservations")
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String       @map("event_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")
  retryCount    Int          @default(0) @map("retry_count")
  errorMessage  String?      @map("error_message")

  // Estado de la notificación a n8n, independiente del estado de outbox/Kafka.
  // null   => este eventType no dispara notificación a n8n
  // SENT   => n8n confirmó recepción del webhook
  // FAILED => n8n no respondió / respondió con error (visible en el dashboard)
  n8nStatus     String?      @map("n8n_status")
  n8nError      String?      @map("n8n_error")
  n8nRetryCount Int          @default(0) @map("n8n_retry_count")
  n8nSentAt     DateTime?    @map("n8n_sent_at")

  @@index([status])
  @@index([aggregateId])
  @@index([n8nStatus])
  @@map("outbox_events")
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  authUserId     String?  @map("auth_user_id")
  reservationId  String?  @map("reservation_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}