generator client {
  provider = "prisma-client"
  output   = "../../generated/user-client"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  id         String   @id @default(uuid())
  authUserId String   @unique
  firstName  String?
  lastName   String?
  phone      String?
  avatar     String?
  role       String   @default("STUDENT")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_profiles")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  authUserId String?
  profileId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}