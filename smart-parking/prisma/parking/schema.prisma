generator client {
  provider = "prisma-client"
  output   = "../../generated/parking-client"
}

datasource db {
  provider = "postgresql"
}

model Faculty {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  zones     Zone[]
  slots     Slot[]

  @@map("faculties")
}

model Zone {
  id              Int      @id @default(autoincrement())
  name            String
  code            String
  centerLatitude  Float    @map("center_latitude")
  centerLongitude Float    @map("center_longitude")
  facultyId       Int      @map("faculty_id")
  faculty         Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  slots           Slot[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("zones")
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  DISABLED
}

model Slot {
  id        String     @id @default(uuid())
  number    String
  status    SlotStatus @default(AVAILABLE)
  latitude  Float
  longitude Float
  zoneId    Int        @map("zone_id")
  zone      Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  facultyId Int        @map("faculty_id")
  faculty   Faculty    @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("slots")
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String       @map("event_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")
  retryCount    Int          @default(0) @map("retry_count")
  errorMessage  String?      @map("error_message")

  // Estado de la notificación a n8n, independiente del estado de outbox/Kafka.
  // null   => este eventType no dispara notificación a n8n
  // SENT   => n8n confirmó recepción del webhook
  // FAILED => n8n no respondió / respondió con error (visible en el dashboard)
  n8nStatus     String?      @map("n8n_status")
  n8nError      String?      @map("n8n_error")
  n8nRetryCount Int          @default(0) @map("n8n_retry_count")
  n8nSentAt     DateTime?    @map("n8n_sent_at")

  @@index([status])
  @@index([aggregateId])
  @@index([n8nStatus])
  @@map("outbox_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  authUserId String?  @map("auth_user_id")
  slotId     String?  @map("slot_id")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
