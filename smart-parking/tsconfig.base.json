{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "paths": {
      "@generated/auth-client/*": ["./generated/auth-client/*"],
      "@generated/user-client/*": ["./generated/user-client/*"],
      "@generated/vehicle-client/*": ["./generated/vehicle-client/*"],
      "@generated/parking-client/*": ["./generated/parking-client/*"],
      "@generated/reservation-client/*": ["./generated/reservation-client/*"]
    }
  }
}